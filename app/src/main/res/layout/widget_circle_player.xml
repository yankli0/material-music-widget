<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        Square anchor container whose smaller axis is MATCH_PARENT and larger axis matches
        min(width, height) in CircleMusicWidgetProvider so the circular vinyl/album art
        fills 100% of whichever of width or height is smaller while keeping the bottom-left
        Play/Stop button and top-right Service badge aligned to the circle perimeter.
    -->
    <FrameLayout
        android:id="@+id/widget_circle_anchor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <!-- Center round album art / Material-adapted vinyl disc -->
        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_album_art"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_preview_disc" />

        <!-- Bottom-left Stop / Play M3 rounded-square button flush to bottom-start corner -->
        <ImageView
            android:id="@+id/widget_play_stop_button"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="bottom|start"
            android:contentDescription="@string/cd_play_button"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play_badge_preview" />

        <!-- Top-right Service Source circular badge flush to top-end corner -->
        <ImageView
            android:id="@+id/widget_service_badge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:contentDescription="@string/cd_service_badge"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_service_badge_preview" />

    </FrameLayout>

</FrameLayout>
